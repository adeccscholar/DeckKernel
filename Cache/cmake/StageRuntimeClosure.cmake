# Run with cmake -P after linking. Package roots are search locations,
# NOT sets of files to copy. Copy the recursive PE import closure only.
cmake_minimum_required(VERSION 3.25)
foreach(_required IN ITEMS ADECC_RUNTIME_EXECUTABLE ADECC_RUNTIME_OUTPUT_DIR
      ADECC_RUNTIME_ROOTS_FILE ADECC_RUNTIME_CONFIGURATION)
   if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
      message(FATAL_ERROR "Missing runtime argument ${_required}")
   endif()
endforeach()
if(NOT WIN32)
   message(FATAL_ERROR "BCC64X runtime closure requires Windows PE")
endif()
if(NOT EXISTS "${ADECC_RUNTIME_EXECUTABLE}" OR
   NOT IS_DIRECTORY "${ADECC_RUNTIME_OUTPUT_DIR}")
   message(FATAL_ERROR "Executable or runtime output directory missing")
endif()
if(NOT ADECC_RUNTIME_CONFIGURATION MATCHES "^(Debug|Release)$")
   message(FATAL_ERROR "Unsupported runtime configuration: ${ADECC_RUNTIME_CONFIGURATION}")
endif()
file(STRINGS "${ADECC_RUNTIME_ROOTS_FILE}" _roots ENCODING UTF-8)
set(_search)
foreach(_root IN LISTS _roots)
   if(NOT IS_DIRECTORY "${_root}")
      message(FATAL_ERROR "Missing active BuildEngine package: ${_root}")
   endif()
   foreach(_bin IN ITEMS
      "${_root}/bin/win64/${ADECC_RUNTIME_CONFIGURATION}"
      "${_root}/bin")
      if(IS_DIRECTORY "${_bin}")
         list(APPEND _search "${_bin}")
      endif()
   endforeach()
endforeach()
set(_seed)
if(DEFINED ADECC_RUNTIME_TOOLCHAIN_DLLS_FILE)
   file(STRINGS "${ADECC_RUNTIME_TOOLCHAIN_DLLS_FILE}" _names ENCODING UTF-8)
   foreach(_name IN LISTS _names)
      if(NOT _name MATCHES "^[A-Za-z0-9_+.-]+[.]dll$")
         message(FATAL_ERROR "Invalid runtime DLL name: ${_name}")
      endif()
      set(_file "${ADECC_RUNTIME_TOOLCHAIN_BIN}/${_name}")
      if(NOT EXISTS "${_file}")
         message(FATAL_ERROR "BCC64X runtime DLL missing: ${_file}")
      endif()
      list(APPEND _seed "${_file}")
   endforeach()
endif()
if(IS_DIRECTORY "${ADECC_RUNTIME_TOOLCHAIN_BIN}")
   list(APPEND _search "${ADECC_RUNTIME_TOOLCHAIN_BIN}")
endif()
list(REMOVE_DUPLICATES _search)

# Target output directories are isolated. Remove only DLLs previously staged
# by this target, before scanning, to prevent stale DLL version resolution.
set(_manifest "${ADECC_RUNTIME_OUTPUT_DIR}/.deckkernel-runtime-closure.txt")
if(EXISTS "${_manifest}")
   file(STRINGS "${_manifest}" _previous ENCODING UTF-8)
   foreach(_name IN LISTS _previous)
      if(NOT _name MATCHES "^[A-Za-z0-9_+.-]+[.]dll$")
         message(FATAL_ERROR "Invalid previously staged DLL name: ${_name}")
      endif()
      file(REMOVE "${ADECC_RUNTIME_OUTPUT_DIR}/${_name}")
   endforeach()
endif()

set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM "windows+pe")
file(GET_RUNTIME_DEPENDENCIES
   EXECUTABLES "${ADECC_RUNTIME_EXECUTABLE}"
   LIBRARIES ${_seed}
   DIRECTORIES ${_search}
   PRE_EXCLUDE_REGEXES "^(api-ms-win-|ext-ms-)"
   POST_EXCLUDE_REGEXES "[/\\][Ww][Ii][Nn][Dd][Oo][Ww][Ss][/\\]"
   RESOLVED_DEPENDENCIES_VAR _resolved
   UNRESOLVED_DEPENDENCIES_VAR _unresolved
   CONFLICTING_DEPENDENCIES_PREFIX _conflicts)
if(_conflicts_FILENAMES)
   message(FATAL_ERROR "PE dependency collisions: ${_conflicts_FILENAMES}")
endif()
foreach(_missing IN LISTS _unresolved)
   string(TOLOWER "${_missing}" _lower)
   if(_lower MATCHES "^(api-ms-win-|ext-ms-)" OR
      EXISTS "$ENV{SystemRoot}/System32/${_missing}")
      continue()
   endif()
   message(FATAL_ERROR "Unresolved PE import: ${_missing}. "
      "Declare its active BuildEngine package instead of staging the entire SDK.")
endforeach()

set(_selected ${_resolved} ${_seed})
list(REMOVE_DUPLICATES _selected)
set(_copied)
set(_keys)
set(_sources)
file(TO_CMAKE_PATH "$ENV{SystemRoot}" _sys)
string(TOLOWER "${_sys}" _sys)
foreach(_source IN LISTS _selected)
   get_filename_component(_name "${_source}" NAME)
   string(TOLOWER "${_name}" _key)
   if(NOT _key MATCHES "[.]dll$")
      continue()
   endif()
   file(TO_CMAKE_PATH "${_source}" _normalized)
   string(TOLOWER "${_normalized}" _normalized)
   string(FIND "${_normalized}" "${_sys}/" _syspos)
   if(NOT _sys STREQUAL "" AND _syspos EQUAL 0)
      continue()
   endif()

   # Do not package arbitrary copies from PATH or the flattened Win64x SDK.
   set(_approved FALSE)
   foreach(_dir IN LISTS _search)
      file(TO_CMAKE_PATH "${_dir}" _dir_norm)
      string(TOLOWER "${_dir_norm}" _dir_norm)
      string(REGEX REPLACE "/+$" "" _dir_norm "${_dir_norm}")
      string(FIND "${_normalized}" "${_dir_norm}/" _position)
      if(_position EQUAL 0)
         set(_approved TRUE)
         break()
      endif()
   endforeach()
   if(NOT _approved)
      message(FATAL_ERROR "Unmanaged PE import ${_source}; "
         "use a declared BuildEngine package runtime directory")
   endif()

   list(FIND _keys "${_key}" _existing)
   if(_existing GREATER_EQUAL 0)
      list(GET _sources ${_existing} _other)
      file(SHA256 "${_source}" _hash)
      file(SHA256 "${_other}" _other_hash)
      if(NOT _hash STREQUAL _other_hash)
         message(FATAL_ERROR "DLL basename collision: ${_source} vs ${_other}")
      endif()
      continue()
   endif()
   file(READ "${_source}" _mz OFFSET 0 LIMIT 2 HEX)
   if(NOT _mz STREQUAL "4d5a")
      message(FATAL_ERROR "Not a PE binary: ${_source}")
   endif()
   file(COPY_FILE "${_source}" "${ADECC_RUNTIME_OUTPUT_DIR}/${_name}"
      ONLY_IF_DIFFERENT)
   list(APPEND _keys "${_key}")
   list(APPEND _sources "${_source}")
   list(APPEND _copied "${_name}")
endforeach()
list(SORT _copied)
string(REPLACE ";" "\n" _text "${_copied}")
file(WRITE "${_manifest}" "${_text}\n")
list(LENGTH _copied _count)
message(STATUS "[RUNTIME] ${_count} DLLs (recursive PE imports) for ${ADECC_RUNTIME_EXECUTABLE}")
