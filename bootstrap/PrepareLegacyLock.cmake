cmake_minimum_required(VERSION 3.25)
# Convert StackBuilder schema-2 lock to the optional 8-package DeckKernel lock.
# cmake -DSTACK_DISTRIBUTION=D:/Distribution/Vision -P bootstrap/PrepareLegacyLock.cmake
if(NOT STACK_DISTRIBUTION)
   message(FATAL_ERROR "Set STACK_DISTRIBUTION to StackBuilder output root")
endif()
set(_input "${STACK_DISTRIBUTION}/thirdparty.lock")
set(_output "${STACK_DISTRIBUTION}/legacy-release.lock")
file(STRINGS "${_input}" _lines ENCODING UTF-8)
list(FIND _lines "StackBuilder-ThirdParty-Lock|2" _header)
if(_header EQUAL -1)
   message(FATAL_ERROR "Not a StackBuilder schema-2 lock")
endif()
set(_wanted libpng libjpeg-turbo libtiff onetbb llvm-openmp opencv leptonica tesseract)
file(WRITE "${_output}" "DeckKernel-Legacy-Release-Lock|1\n")
set(_seen)
foreach(_line IN LISTS _lines)
   if(NOT _line MATCHES "^package[|]")
      continue()
   endif()
   string(REPLACE "|" ";" _fields "${_line}")
   list(LENGTH _fields _n)
   if(NOT _n EQUAL 7)
      message(FATAL_ERROR "Invalid package line")
   endif()
   list(GET _fields 1 _name)
   list(GET _fields 2 _version)
   list(GET _fields 3 _release)
   list(GET _fields 4 _relative)
   list(GET _fields 5 _size)
   list(GET _fields 6 _sha)
   if(NOT _name IN_LIST _wanted OR _name IN_LIST _seen OR NOT _release STREQUAL "2026.09.26-1")
      message(FATAL_ERROR "Unexpected or duplicate legacy package: ${_name}")
   endif()
   get_filename_component(_archive "${_relative}" NAME)
   set(_path "${STACK_DISTRIBUTION}/packages/${_archive}")
   if(NOT EXISTS "${_path}")
      message(FATAL_ERROR "Missing ZIP: ${_path}")
   endif()
   file(SIZE "${_path}" _actual_size)
   file(SHA256 "${_path}" _actual_sha)
   if(NOT _actual_size STREQUAL _size OR NOT _actual_sha STREQUAL _sha)
      message(FATAL_ERROR "Invalid StackBuilder archive bytes/hash: ${_archive}")
   endif()
   file(APPEND "${_output}" "package|${_name}|${_version}|${_release}|${_archive}|${_size}|${_sha}\n")
   list(APPEND _seen "${_name}")
endforeach()
list(LENGTH _seen _count)
if(NOT _count EQUAL 8)
   message(FATAL_ERROR "Expected eight packages, got ${_count}")
endif()
message(STATUS "[LEGACY] Eight ZIPs verified; candidate lock: ${_output}")
