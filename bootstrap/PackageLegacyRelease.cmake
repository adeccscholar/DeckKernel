cmake_minimum_required(VERSION 3.25)
# Create ZIPs from installed BCC64X DLL packages, not static archives.
# cmake -DLEGACY_INSTALL_ROOT=<install/packages> -DLEGACY_OUTPUT_ROOT=<output> -P bootstrap/PackageLegacyRelease.cmake
if(NOT LEGACY_INSTALL_ROOT OR NOT LEGACY_OUTPUT_ROOT)
   message(FATAL_ERROR "Set LEGACY_INSTALL_ROOT and LEGACY_OUTPUT_ROOT.")
endif()
get_filename_component(_repo "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
file(READ "${_repo}/Cache/LegacyReleasePackages.xml" _xml)
string(REGEX MATCHALL "<package name=\"[^\"]+\" version=\"[^\"]+\"[^>]*/>" _entries "${_xml}")
if(NOT _entries)
   message(FATAL_ERROR "Legacy release has no entries.")
endif()
file(MAKE_DIRECTORY "${LEGACY_OUTPUT_ROOT}")
set(_lock "${LEGACY_OUTPUT_ROOT}/legacy-release.lock")
file(WRITE "${_lock}" "DeckKernel-Legacy-Release-Lock|1\n")
foreach(_entry IN LISTS _entries)
   string(REGEX MATCH "name=\"([^\"]+)\"" _match "${_entry}")
   set(_name "${CMAKE_MATCH_1}")
   string(REGEX MATCH "version=\"([^\"]+)\"" _match "${_entry}")
   set(_version "${CMAKE_MATCH_1}")
   set(_dir "${LEGACY_INSTALL_ROOT}/${_name}/${_version}")
   if(NOT IS_DIRECTORY "${_dir}/include" OR NOT IS_DIRECTORY "${_dir}/bin")
      message(FATAL_ERROR "Installed package lacks include/bin: ${_dir}")
   endif()
   file(GLOB_RECURSE _dlls LIST_DIRECTORIES false "${_dir}/bin/*.dll")
   if(NOT _dlls)
      message(FATAL_ERROR "Missing dynamic DLL runtime: ${_dir}")
   endif()
   set(_filename "${_name}-${_version}-bcc64x.zip")
   set(_archive "${LEGACY_OUTPUT_ROOT}/${_filename}")
   execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${_archive}" --format=zip "${_version}"
      WORKING_DIRECTORY "${LEGACY_INSTALL_ROOT}/${_name}"
      RESULT_VARIABLE _result ERROR_VARIABLE _error)
   if(NOT _result EQUAL 0)
      message(FATAL_ERROR "Failed to archive ${_name}: ${_error}")
   endif()
   file(SIZE "${_archive}" _size)
   file(SHA256 "${_archive}" _sha256)
   file(APPEND "${_lock}" "package|${_name}|${_version}|2026.09.26-1|${_filename}|${_size}|${_sha256}\n")
   message(STATUS "[PACKAGE] ${_name}${_version}: ${_size} bytes, SHA256=${_sha256}")
endforeach()
message(STATUS "Staged ZIPs and candidate lock created under ${LEGACY_OUTPUT_ROOT}")
message(STATUS "Publish ZIPs to existing 2026.09.26-1 release before activating the lock.")
